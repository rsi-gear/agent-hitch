{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rsi-gear/agent-hitch/docs/schemas/message-feedback.schema.json",
  "title": "Message feedback sidecar row",
  "description": "Lifecycle-bound editable message feedback sidecar, one whole-session row per session (spec §6.2). A lifecycle identity mismatch is treated as absence. Compare-and-set uses opaque UUID versions; ifVersion null requests creation only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["session", "items"],
  "properties": {
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt"],
      "properties": {
        "sessionId": { "type": "string" },
        "createdAt": { "type": "integer", "minimum": 0 },
        "cwd": { "type": "string" }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["messageId", "rating", "version", "createdAt", "updatedAt"],
        "properties": {
          "messageId": { "type": "string", "minLength": 1 },
          "rating": { "enum": ["positive", "negative"] },
          "note": { "type": "string" },
          "version": { "type": "string", "minLength": 1 },
          "createdAt": { "type": "integer", "minimum": 0 },
          "updatedAt": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
