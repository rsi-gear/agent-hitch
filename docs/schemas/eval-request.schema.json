{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/eval-request.schema.json",
  "title": "Hitch eval request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backend",
    "dataset",
    "harness_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "backend": {
      "const": "harbor"
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_revision": {
      "type": "string",
      "minLength": 1
    },
    "harness_ref": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string"
    },
    "attempts": {
      "type": "integer",
      "minimum": 1
    },
    "max_concurrent": {
      "type": "integer",
      "minimum": 1
    },
    "infrastructure_retries": {
      "type": "integer",
      "minimum": 0
    },
    "infrastructure_retry_backoff_ms": {
      "type": "number",
      "minimum": 0
    },
    "timeout_ms": {
      "type": "number",
      "minimum": 0
    },
    "setup_timeout_ms": {
      "type": "number",
      "minimum": 0
    },
    "agent_args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pass_env": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "training_binding": {
      "$ref": "training-external-binding.schema.json"
    },
    "environment_binding": {
      "type": "string",
      "pattern": "^hmac-sha256:[a-f0-9]{64}$"
    },
    "artifact_pins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "eval-artifact-pin.schema.json"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "platform"
            ],
            "properties": {
              "platform": {
                "const": "linux-x64"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "platform"
            ],
            "properties": {
              "platform": {
                "const": "linux-arm64"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    },
    "endpoint_binding": {
      "$ref": "external-endpoint-binding.schema.json"
    },
    "model_binding": {
      "$ref": "ready-endpoint-binding.schema.json"
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "temperature": {
          "type": "number"
        },
        "top_p": {
          "type": "number"
        },
        "top_k": {
          "type": "number"
        },
        "min_p": {
          "type": "number"
        },
        "repetition_penalty": {
          "type": "number"
        },
        "seed": {
          "type": "number"
        }
      }
    },
    "resource_config": {
      "$ref": "approved-resource-configuration.schema.json"
    }
  }
}
