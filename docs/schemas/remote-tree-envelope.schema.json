{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/remote-tree-envelope.schema.json",
  "title": "Hitch remote tree envelope V1",
  "description": "The runtime also validates canonical paths, order, unique entries, total limits, safe symlink targets and file digests.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "files"],
  "properties": {
    "schema_version": { "const": "1" },
    "directories": { "type": "array", "maxItems": 100000, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "mode"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "mode": { "type": "integer", "minimum": 256, "maximum": 511 } }
    } },
    "symlinks": { "type": "array", "maxItems": 100000, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "target"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "target": { "type": "string", "minLength": 1 } }
    } },
    "files": {
      "type": "array", "maxItems": 100000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "mode", "size", "sha256", "content_base64"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "mode": { "type": "integer", "minimum": 256, "maximum": 511 },
          "size": { "type": "integer", "minimum": 0, "maximum": 268435456 },
          "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "content_base64": { "type": "string", "contentEncoding": "base64" }
        }
      }
    }
  },
  "anyOf": [
    { "properties": { "files": { "minItems": 1 } } },
    { "required": ["directories"], "properties": { "directories": { "minItems": 1 } } },
    { "required": ["symlinks"], "properties": { "symlinks": { "minItems": 1 } } }
  ]
}
