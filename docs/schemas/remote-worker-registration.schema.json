{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/remote-worker-registration.schema.json",
  "title": "Hitch remote worker registration V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "worker_id", "provider", "collision_domain_id", "platforms", "backends", "features", "task_membership", "capacity"],
  "properties": {
    "schema_version": { "const": "1" },
    "worker_id": { "$ref": "#/$defs/workerId" },
    "provider": { "type": "string", "minLength": 1, "maxLength": 256 },
    "collision_domain_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "backends": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "version"],
        "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } }
      }
    },
    "features": {
      "type": "object", "additionalProperties": false,
      "required": ["docker", "buildkit", "model_proxy", "isolated_same_task_attempts"],
      "properties": {
        "docker": { "type": "boolean" }, "buildkit": { "type": "boolean" },
        "model_proxy": { "type": "boolean" }, "isolated_same_task_attempts": { "type": "boolean" }
      }
    },
    "task_membership": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["known", "opaque"] } },
    "capacity": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "reserved_for_system", "allocatable"],
      "properties": {
        "total": { "$ref": "#/$defs/resources" }, "reserved_for_system": { "$ref": "#/$defs/resources" },
        "allocatable": { "$ref": "#/$defs/resources" }
      }
    }
  },
  "$defs": {
    "workerId": { "type": "string", "pattern": "^worker_[a-z0-9][a-z0-9_-]{0,62}$" },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu_millis", "memory_bytes", "container_slots", "build_slots"],
      "properties": {
        "cpu_millis": { "type": "integer", "minimum": 0 }, "memory_bytes": { "type": "integer", "minimum": 0 },
        "container_slots": { "type": "integer", "minimum": 0 }, "build_slots": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
