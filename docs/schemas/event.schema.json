{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/event.schema.json",
  "title": "Hitch normalized event",
  "type": "object",
  "required": ["schema_version", "sequence", "timestamp", "run_id", "type"],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[a-f0-9]{32}$"
    },
    "type": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
