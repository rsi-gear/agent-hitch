{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rsi-gear/agent-hitch/docs/schemas/controller-runtime-manifest.schema.json",
  "title": "Controller runtime manifest",
  "description": "Content-addressed manifest for a shared read-only Hitch controller runtime bundle (spec §4.3). The runtime_id is the SHA-256 of the canonical encoding of { schema_version, node_range, entrypoints, files }; created_at is descriptive and excluded from the identity. The declared CLI entrypoint participates in the identity hash and is executed by the Harbor bridge relative to the upload root (/opt/hitch).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime_id", "node_range", "entrypoints", "files", "created_at"],
  "properties": {
    "schema_version": { "const": "2" },
    "runtime_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "node_range": { "const": ">=22" },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cli"],
      "properties": {
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "launcher"],
          "properties": {
            "path": {
              "type": "string",
              "description": "CLI entrypoint relative to the upload root (/opt/hitch). Must be one of the declared files; no absolute paths or traversal.",
              "minLength": 1
            },
            "launcher": { "const": "node" }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "executable", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Normalized NFC path with / separators, relative to the payload root.",
            "minLength": 1
          },
          "size": { "type": "integer", "minimum": 0 },
          "executable": { "type": "boolean" },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      },
      "uniqueItems": true
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
