{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/local-git-transport-manifest.schema.json",
  "title": "Hitch local Git commit transport manifest",
  "description": "Proof for a size-limited Git object pack containing one exact local commit and its checkout tree. The Git commit remains the harness revision identity; payload_sha256 only proves transport integrity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "harness_id",
    "resolution_identity",
    "commit",
    "tree",
    "payload_sha256",
    "payload_bytes",
    "object_count",
    "file_count",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "kind": { "const": "local-git-commit" },
    "harness_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "resolution_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "tree": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "payload_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "payload_bytes": { "type": "integer", "minimum": 0 },
    "object_count": { "type": "integer", "minimum": 0 },
    "file_count": { "type": "integer", "minimum": 0 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
