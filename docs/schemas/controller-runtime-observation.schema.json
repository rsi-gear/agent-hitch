{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/controller-runtime-observation.schema.json",
  "title": "Hitch controller runtime observation V2",
  "description": "Reports the loaded package's compiled payload and its own source checkout, without paths or credentials. An installed package never borrows its parent repository's commit. This is not GPU or sandbox validation.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "package_version", "node_version", "runtime_id", "source"],
  "properties": {
    "schema_version": { "const": "2" }, "package_version": { "type": "string", "minLength": 1 },
    "node_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+" },
    "runtime_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source": { "oneOf": [
      { "type": "object", "additionalProperties": false, "required": ["kind", "commit", "dirty"], "properties": {
        "kind": { "const": "git-checkout" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }, "dirty": { "type": "boolean" }
      } },
      { "type": "object", "additionalProperties": false, "required": ["kind", "commit", "dirty"], "properties": {
        "kind": { "const": "unavailable" }, "commit": { "type": "null" }, "dirty": { "type": "null" }
      } }
    ] }
  }
}
