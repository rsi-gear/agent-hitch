{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/environment-build-record.schema.json",
  "title": "Hitch environment build record V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "build_id", "cache_key", "state", "owner_id", "builder_id", "started_at"],
  "properties": {
    "schema_version": { "const": "1" },
    "build_id": { "type": "string", "pattern": "^build_[a-f0-9]{32}$" },
    "cache_key": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "state": { "enum": ["running", "succeeded", "failed"] },
    "owner_id": { "type": "string", "minLength": 1 },
    "builder_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "image_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 } }
    }
  }
}
