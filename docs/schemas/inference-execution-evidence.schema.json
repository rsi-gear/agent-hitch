{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/inference-execution-evidence.schema.json",
  "title": "Hitch inference execution evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "service", "doctor", "prepared_at"],
  "properties": {
    "schema_version": { "const": "1" },
    "run_id": { "type": "string", "pattern": "^run_[a-f0-9]{32}$" },
    "eval_id": { "type": "string", "pattern": "^eval_[a-f0-9]{32}$" },
    "rerun_id": { "type": "string", "pattern": "^rerun_[a-f0-9]{32}$" },
    "service": {
      "type": "object", "additionalProperties": false,
      "required": ["service_id", "epoch", "isolation_key"],
      "properties": {
        "service_id": { "type": "string", "pattern": "^inference_[a-f0-9]{32}$" },
        "epoch": { "type": "integer", "minimum": 1 },
        "isolation_key": { "$ref": "#/$defs/sha256" }
      }
    },
    "doctor": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "backend", "ready", "checks"],
          "properties": {
            "schema_version": { "const": "1" }, "backend": { "enum": ["cpu", "cuda", "metal"] }, "ready": { "type": "boolean" },
            "checks": { "type": "object", "additionalProperties": { "$ref": "#/$defs/check" } },
            "gpu": {
              "type": "object", "additionalProperties": false, "required": ["uuid", "name", "memory_mib", "driver_version"],
              "properties": {
                "uuid": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 },
                "memory_mib": { "type": "number", "exclusiveMinimum": 0 }, "driver_version": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ]
    },
    "prepared_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [{ "if": { "required": ["rerun_id"] }, "then": { "required": ["eval_id"] } }],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["status", "message"],
      "properties": { "status": { "enum": ["pass", "fail"] }, "message": { "type": "string" } }
    }
  }
}
