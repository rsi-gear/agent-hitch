{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/local-inference-selection.schema.json",
  "title": "Hitch local inference selection",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model": {
      "type": "string",
      "pattern": "^local/(?:[a-z0-9][a-z0-9._-]{0,63}|sha256:[a-f0-9]{64})$"
    },
    "device": {
      "enum": [
        "auto",
        "cpu",
        "cuda",
        "metal"
      ],
      "default": "auto"
    },
    "profile": {
      "enum": [
        "baseline",
        "throughput"
      ],
      "default": "baseline"
    },
    "offline": {
      "type": "boolean",
      "default": false
    },
    "inference_id": {
      "$ref": "#/$defs/sha256"
    },
    "model_node": {
      "$ref": "#/$defs/modelNodeBinding"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "inference_id"
        ],
        "not": {
          "required": [
            "model_node"
          ]
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "device"
              ]
            },
            {
              "required": [
                "profile"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "model_node"
        ]
      },
      "then": {
        "required": [
          "inference_id"
        ],
        "properties": {
          "device": {
            "const": "auto"
          },
          "profile": {
            "const": "baseline"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "modelNodeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "node_id",
        "generation",
        "runtime_digest",
        "launcher"
      ],
      "properties": {
        "schema_version": {
          "const": "2"
        },
        "node_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "generation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "runtime_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "launcher": {
          "const": "process"
        }
      }
    }
  }
}
