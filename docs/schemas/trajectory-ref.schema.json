{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/trajectory-ref.schema.json",
  "title": "Hitch trajectory reference",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "session_id", "format", "fidelity", "path"],
      "properties": {
        "schema_version": { "const": "1" },
        "run_id": { "type": "string", "pattern": "^run_[a-f0-9]{32}$" },
        "session_id": { "type": "string", "minLength": 1 },
        "provider_session_id": { "type": "string" },
        "format": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "version", "contract_commit", "compression", "pack_chunks"],
          "properties": {
            "family": { "const": "dsh-session" },
            "version": { "const": 0 },
            "contract_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "compression": { "const": "none" },
            "pack_chunks": { "const": false }
          }
        },
        "fidelity": { "enum": ["native", "normalized", "minimal"] },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_id", "fidelity", "files"],
      "properties": {
        "schema_version": { "const": "2" },
        "run_id": { "type": "string", "pattern": "^run_[a-f0-9]{32}$" },
        "fidelity": { "enum": ["provider_native", "normalized", "minimal"] },
        "provider": { "type": "string", "minLength": 1 },
        "provider_session_id": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "path", "media_type", "sha256", "bytes"],
            "properties": {
              "role": { "enum": ["provider_events", "provider_transcript", "provider_artifact", "canonical_session"] },
              "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
              "media_type": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "redactions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "count"],
            "properties": {
              "rule_id": { "type": "string", "minLength": 1 },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  ]
}
