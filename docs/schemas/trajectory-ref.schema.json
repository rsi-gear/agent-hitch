{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rsi-gear/agent-hitch/docs/schemas/trajectory-ref.schema.json",
  "title": "Trajectory reference",
  "description": "Pointer to the canonical DSH-compatible trajectory of a run, with explicit translation fidelity (spec §5.5). Gear trajectory.query() must prefer this file and use events.jsonl only for legacy runs (spec §5.7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "session_id", "format", "fidelity", "path"],
  "properties": {
    "schema_version": { "const": "1" },
    "run_id": { "type": "string", "pattern": "^run_[a-f0-9]{32}$" },
    "session_id": { "type": "string", "minLength": 1 },
    "provider_session_id": { "type": "string" },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "version", "contract_commit", "compression", "pack_chunks"],
      "properties": {
        "family": { "const": "dsh-session" },
        "version": { "const": 0 },
        "contract_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "compression": { "const": "none" },
        "pack_chunks": { "const": false }
      }
    },
    "fidelity": { "enum": ["native", "normalized", "minimal"] },
    "path": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
