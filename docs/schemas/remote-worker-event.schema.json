{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/remote-worker-event.schema.json",
  "title": "Hitch remote worker event V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation", "lease_id", "epoch", "sequence", "type", "sent_at"],
  "properties": {
    "schema_version": { "const": "1" },
    "generation": { "type": "integer", "minimum": 1 },
    "lease_id": { "type": "string", "pattern": "^lease_[a-f0-9]{32}$" },
    "epoch": { "type": "integer", "minimum": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "type": { "type": "string", "minLength": 1, "maxLength": 256 },
    "payload": { "type": "object" },
    "sent_at": { "type": "string", "format": "date-time" }
  }
}
