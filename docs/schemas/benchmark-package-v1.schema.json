{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitch.dev/schemas/benchmark-package-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "protocol": {
      "const": "hitch-benchmark@1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "task_root": {
      "type": "string",
      "minLength": 1
    },
    "task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "default_profile": {
      "type": "string",
      "minLength": 1
    },
    "primary_metric": {
      "type": "string",
      "minLength": 1
    },
    "task_format": {
      "type": "object",
      "properties": {
        "name": {
          "const": "harbor"
        },
        "schema_version": {
          "const": "1.4"
        }
      },
      "required": [
        "name",
        "schema_version"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "local",
            "git"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "resolved_revision": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "enum": [
            "public",
            "private",
            "gated"
          ]
        }
      },
      "required": [
        "kind",
        "license"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "benchmark-metric-v1.schema.json"
      }
    },
    "publication": {
      "type": "object",
      "properties": {
        "track": {
          "enum": [
            "custom",
            "public-subset"
          ]
        },
        "training_eligible": {
          "const": false
        }
      },
      "required": [
        "track",
        "training_eligible"
      ],
      "additionalProperties": false
    },
    "runtime_components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "protocol": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "protocol",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "protocol",
    "id",
    "release",
    "task_root",
    "task_ids",
    "default_profile",
    "primary_metric",
    "task_format",
    "source",
    "metrics",
    "publication"
  ],
  "additionalProperties": false
}
