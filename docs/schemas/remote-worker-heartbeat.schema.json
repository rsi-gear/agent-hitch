{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/remote-worker-heartbeat.schema.json",
  "title": "Hitch remote worker heartbeat V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation", "health", "allocated", "active_leases", "sent_at"],
  "properties": {
    "schema_version": { "const": "1" },
    "generation": { "type": "integer", "minimum": 1 },
    "health": { "enum": ["healthy", "degraded", "unavailable"] },
    "allocated": { "$ref": "#/$defs/resources" },
    "active_leases": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["lease_id", "epoch"],
        "properties": {
          "lease_id": { "type": "string", "pattern": "^lease_[a-f0-9]{32}$" },
          "epoch": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "sent_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu_millis", "memory_bytes", "container_slots", "build_slots"],
      "properties": {
        "cpu_millis": { "type": "integer", "minimum": 0 }, "memory_bytes": { "type": "integer", "minimum": 0 },
        "container_slots": { "type": "integer", "minimum": 0 }, "build_slots": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
