{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/artifact-manifest.schema.json",
  "title": "Hitch prepared artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "harness_id",
    "revision_identity",
    "source_type",
    "adapter",
    "adapter_version",
    "recipe_version",
    "platform",
    "entrypoint",
    "launcher",
    "entrypoint_integrity",
    "toolchain",
    "resolved_revision",
    "prepared_at"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "artifact_id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "harness_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "revision_identity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source_type": { "enum": ["installed", "npm", "git"] },
    "adapter": { "type": "string", "minLength": 1 },
    "adapter_version": { "type": "string", "minLength": 1 },
    "recipe_version": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "entrypoint": { "type": "string", "minLength": 1 },
    "launcher": { "enum": ["direct", "node"] },
    "entrypoint_integrity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "toolchain": { "type": "object", "additionalProperties": { "type": "string" } },
    "resolved_revision": { "$ref": "resolved-revision.schema.json" },
    "dependency_lock": { "type": ["string", "null"] },
    "observed_version": { "type": ["string", "null"] },
    "external": { "type": "boolean" },
    "prepared_at": { "type": "string", "format": "date-time" }
  }
}
