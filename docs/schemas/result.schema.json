{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/result.schema.json",
  "title": "Hitch run result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "exit_code",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[a-f0-9]{32}$"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "timed_out",
        "cancelled"
      ]
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0
    },
    "output": {
      "type": "string"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "trajectory_warning": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "const": "trajectory_recording_failed"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stopped"
      ],
      "properties": {
        "stopped": {
          "type": "boolean"
        }
      }
    },
    "generation_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_requests",
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "tokens"
      ],
      "properties": {
        "model_requests": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  }
}
