{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/benchmark-phase-group.schema.json",
  "title": "Hitch benchmark phase candidate evidence group V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "scope", "run_group_id", "eval_id", "trial_id", "attempt", "benchmark_id", "benchmark_revision", "task_id", "verifier_identity", "harness", "model", "phases", "created_at"],
  "properties": {
    "schema_version": { "const": "1" },
    "kind": { "const": "benchmark-phase-group" },
    "scope": { "const": "candidate-evidence-only" },
    "run_group_id": { "type": "string", "pattern": "^run_group_[a-f0-9]{32}$" },
    "eval_id": { "type": "string", "pattern": "^eval_[a-f0-9]{32}$" },
    "trial_id": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "benchmark_revision": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "verifier_identity": { "$ref": "#/$defs/digest" },
    "harness": { "$ref": "run-manifest.schema.json#/properties/harness" },
    "model": { "$ref": "run-manifest.schema.json#/properties/model" },
    "phases": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["phase_index", "run_id", "process_status", "provider_session_id", "bundle_digest", "bundle_index_digest"],
        "properties": {
          "phase_index": { "type": "integer", "minimum": 1 },
          "run_id": { "type": "string", "pattern": "^run_[a-f0-9]{32}$" },
          "process_status": { "enum": ["succeeded", "failed", "timed_out", "cancelled"] },
          "provider_session_id": { "type": "string", "minLength": 1 },
          "bundle_digest": { "$ref": "#/$defs/digest" },
          "bundle_index_digest": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
