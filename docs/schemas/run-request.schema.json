{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/run-request.schema.json",
  "title": "Hitch run request",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt"],
  "allOf": [{
    "if": { "properties": { "context": { "properties": { "kind": { "const": "benchmark_phase" } }, "required": ["kind"] } }, "required": ["context"] },
    "then": { "required": ["parent"], "properties": { "defer_benchmark_observation": { "const": false } } }
  }],
  "oneOf": [
    {
      "required": ["harness_ref"],
      "not": { "required": ["agent"] }
    },
    {
      "required": ["agent"],
      "not": { "required": ["harness_ref"] }
    }
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "harness_ref": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string"
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "workspace_mode": {
      "enum": ["shared", "worktree", "copy"],
      "default": "shared"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "timeout_ms": {
      "type": "number",
      "minimum": 0
    },
    "agent_args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context": { "$ref": "run-context.schema.json" },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "eval_id", "trial_id", "attempt"],
      "properties": {
        "kind": { "const": "eval" },
        "eval_id": { "type": "string", "pattern": "^eval_[a-f0-9]{32}$" },
        "trial_id": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "model_identity": { "type": "object" },
    "protocol_identity": { "type": "object" },
    "defer_benchmark_observation": { "type": "boolean" }
  }
}
