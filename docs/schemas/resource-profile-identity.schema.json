{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/resource-profile-identity.schema.json",
  "title": "Frozen resource profile identity V1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "tasks", "task_set_digest", "harness_artifact_digest", "controller_runtime_digest", "runtime_contract_digest", "role_images", "platform", "backend", "input_scale", "resource_parameters"],
  "properties": {
    "schema_version": { "const": "1" },
    "tasks": { "type": "array", "minItems": 1, "maxItems": 100000, "items": { "type": "object", "additionalProperties": false, "required": ["task_id", "task_digest"], "properties": { "task_id": { "type": "string", "minLength": 1 }, "task_digest": { "$ref": "#/$defs/digest" } } } },
    "task_set_digest": { "$ref": "#/$defs/digest" },
    "harness_artifact_digest": { "$ref": "#/$defs/digest" },
    "controller_runtime_digest": { "$ref": "#/$defs/digest" },
    "runtime_contract_digest": { "$ref": "#/$defs/digest" },
    "role_images": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "object", "additionalProperties": false, "required": ["component_id", "image_digest", "replicas"], "properties": { "component_id": { "type": "string", "minLength": 1 }, "image_digest": { "$ref": "#/$defs/digest" }, "replicas": { "type": "integer", "minimum": 1 } } } },
    "platform": { "type": "string", "minLength": 1 },
    "backend": { "type": "object", "additionalProperties": false, "required": ["id", "version", "provider", "lifecycle_digest"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "provider": { "type": "string", "minLength": 1 }, "lifecycle_digest": { "$ref": "#/$defs/digest" } } },
    "input_scale": { "type": "object" }, "resource_parameters": { "type": "object" }
  },
  "$defs": { "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" } }
}
