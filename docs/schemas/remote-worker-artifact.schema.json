{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/remote-worker-artifact.schema.json",
  "title": "Hitch remote worker staged artifact V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "worker_id", "lease_id", "epoch", "digest", "size", "completed_at"],
  "properties": {
    "schema_version": { "const": "1" },
    "worker_id": { "type": "string", "pattern": "^worker_[a-z0-9][a-z0-9_-]{0,62}$" },
    "lease_id": { "type": "string", "pattern": "^lease_[a-f0-9]{32}$" },
    "epoch": { "type": "integer", "minimum": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "size": { "type": "integer", "minimum": 0, "maximum": 536870912 },
    "completed_at": { "type": "string", "format": "date-time" }
  }
}
