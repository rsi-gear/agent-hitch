{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/run-environment-images.schema.json",
  "title": "Hitch sealed run environment image evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "uses", "manifests"],
  "properties": {
    "schema_version": { "const": "1" },
    "task_id": { "type": "string", "minLength": 1 },
    "uses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_ids", "image_id", "requested_reference", "reference", "manifest_digest", "platform", "resolution", "cache_hit"],
        "properties": {
          "task_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "image_id": { "$ref": "#/$defs/sha256" },
          "requested_reference": { "type": "string", "minLength": 1 },
          "reference": { "type": "string", "minLength": 1 },
          "manifest_digest": { "$ref": "#/$defs/sha256" },
          "platform": { "type": "string", "minLength": 1 },
          "resolution": { "enum": ["registry", "prebuilt", "backend-build"] },
          "cache_hit": { "type": "boolean" }
        }
      }
    },
    "manifests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "environment-image-manifest.schema.json" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
