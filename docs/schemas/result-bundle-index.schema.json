{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/result-bundle-index.schema.json",
  "title": "Hitch sealed result bundle index V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "sealed", "context_identity", "files", "provenance", "bundle_digest", "created_at"],
  "properties": {
    "schema_version": { "const": "1" },
    "run_id": { "type": "string", "pattern": "^run_[a-f0-9]{32}$" },
    "sealed": { "const": true },
    "context_identity": { "$ref": "#/$defs/sha256" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "size", "sha256"],
        "properties": {
          "role": {
            "enum": [
              "request", "resolution", "manifest", "result", "runtime-ref", "environment-manifest",
              "execution-evidence", "control-events", "process-log", "workspace-evidence", "trajectory",
              "provider-evidence", "verifier-evidence", "interaction-capture", "eval-publication", "diagnostic"
            ]
          },
          "path": { "$ref": "#/$defs/relativePath" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images", "provider"],
      "properties": {
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["image_id", "image_digest", "reference"],
            "properties": {
              "image_id": { "$ref": "#/$defs/sha256" },
              "image_digest": { "$ref": "#/$defs/sha256" },
              "reference": { "type": "string", "minLength": 1 }
            }
          }
        },
        "provider": { "type": "string", "minLength": 1 },
        "worker_id": { "type": "string", "minLength": 1 },
        "lease_id": { "type": "string", "pattern": "^lease_[a-f0-9]{32}$" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested"],
      "properties": {
        "requested": { "$ref": "#/$defs/resources" },
        "observed": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "interaction_ref": { "$ref": "#/$defs/relativePath" },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "required", "completeness", "interaction_count", "redaction"],
      "properties": {
        "mode": { "enum": ["off", "native", "proxy", "hybrid"] },
        "required": { "type": "boolean" },
        "completeness": { "enum": ["complete", "partial", "none"] },
        "interaction_count": { "type": "integer", "minimum": 0 },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "status", "rules"],
          "properties": {
            "policy": { "type": "string", "minLength": 1, "maxLength": 256 },
            "status": { "enum": ["applied", "not-needed", "failed"] },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rule_id", "count"],
                "properties": {
                  "rule_id": { "type": "string", "minLength": 1 },
                  "count": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "harness_revision": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "artifact_id": { "$ref": "#/$defs/sha256" },
        "controller_runtime_id": { "$ref": "#/$defs/sha256" },
        "benchmark_id": { "type": "string" },
        "benchmark_revision": { "type": "string" },
        "verifier_identity": { "$ref": "#/$defs/sha256" }
      }
    },
    "bundle_digest": { "$ref": "#/$defs/sha256" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_millis", "memory_bytes", "container_slots", "build_slots"],
      "properties": {
        "cpu_millis": { "type": "integer", "minimum": 0 },
        "memory_bytes": { "type": "integer", "minimum": 0 },
        "container_slots": { "type": "integer", "minimum": 0 },
        "build_slots": { "type": "integer", "minimum": 0 },
        "gpu_count": { "type": "integer", "minimum": 0 }
      }
    },
    "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" }
  }
}
