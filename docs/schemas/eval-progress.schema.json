{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/eval-progress.schema.json",
  "title": "Hitch running eval progress",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "eval_id",
    "benchmark_id",
    "benchmark_revision",
    "status",
    "generation",
    "planned_tasks",
    "planned_trials",
    "trials",
    "summary",
    "started_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "eval_id": { "type": "string", "pattern": "^eval_[a-f0-9]{32}$" },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "benchmark_revision": { "type": "string", "minLength": 1 },
    "status": { "const": "running" },
    "generation": { "type": "integer", "minimum": 0 },
    "planned_tasks": { "type": ["integer", "null"], "minimum": 0 },
    "planned_trials": { "type": ["integer", "null"], "minimum": 0 },
    "trials": {
      "type": "array",
      "items": { "$ref": "eval-trial-reference.schema.json" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settled_trials", "valid_trials", "invalid_trials"],
      "properties": {
        "settled_trials": { "type": "integer", "minimum": 0 },
        "valid_trials": { "type": "integer", "minimum": 0 },
        "invalid_trials": { "type": "integer", "minimum": 0 }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
