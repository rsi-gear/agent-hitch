{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hitch.dev/schemas/benchmark-lock-v1.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "protocol": {
      "const": "hitch-benchmark@1"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "release": {
      "type": "string",
      "minLength": 1
    },
    "package_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "local",
            "git"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "resolved_revision": {
          "type": "string",
          "minLength": 1
        },
        "access": {
          "enum": [
            "public",
            "private",
            "gated"
          ]
        },
        "manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "uri",
        "resolved_revision",
        "access",
        "manifest_digest"
      ],
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "resolved_revision": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "role",
          "uri",
          "resolved_revision",
          "digest"
        ],
        "additionalProperties": false
      }
    },
    "resolver": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "code_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "code_digest"
      ],
      "additionalProperties": false
    },
    "task_dialect": {
      "type": "object",
      "properties": {
        "name": {
          "const": "harbor"
        },
        "schema_version": {
          "const": "1.4"
        }
      },
      "required": [
        "name",
        "schema_version"
      ],
      "additionalProperties": false
    },
    "runtime_components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "protocol": {
            "type": "string",
            "minLength": 1
          },
          "content_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "protocol",
          "content_digest"
        ],
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "source_task_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "task_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "input_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "grader_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "environment_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "const": "build"
                },
                "context_digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "base_image_digests": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                },
                "platform": {
                  "const": "linux/amd64"
                }
              },
              "required": [
                "role",
                "kind",
                "context_digest",
                "base_image_digests",
                "platform"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "task_id",
          "source_task_id",
          "path",
          "task_digest",
          "input_digest",
          "grader_digest",
          "environment_refs"
        ],
        "additionalProperties": false
      }
    },
    "profile_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metric_spec_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511
          }
        },
        "required": [
          "path",
          "digest",
          "bytes",
          "mode"
        ],
        "additionalProperties": false
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "before": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "after": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "kind",
          "before",
          "after"
        ],
        "additionalProperties": false
      }
    },
    "source_adapter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "code_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "version",
        "code_digest"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "protocol",
    "benchmark_id",
    "release",
    "package_digest",
    "source",
    "components",
    "resolver",
    "task_dialect",
    "runtime_components",
    "tasks",
    "profile_digest",
    "required_capabilities",
    "metric_spec_digest",
    "files",
    "transformations"
  ],
  "additionalProperties": false
}
