{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/remote-physical-execution.schema.json",
  "title": "Hitch remote physical execution V2",
  "description": "Derives a physical work ID from an unchanged frozen logical plan. The worker additionally verifies all work fields against the original source and rejects training slot reruns.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "source_work_id",
        "rerun_id"
      ],
      "properties": {
        "schema_version": {
          "const": "2"
        },
        "kind": {
          "const": "candidate-restart"
        },
        "source_work_id": {
          "$ref": "#/$defs/workId"
        },
        "rerun_id": {
          "type": "string",
          "pattern": "^rerun_[a-f0-9]{32}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "source_work_id",
        "retry_index",
        "trigger_trial_ids"
      ],
      "properties": {
        "schema_version": {
          "const": "2"
        },
        "kind": {
          "const": "physical-infrastructure-retry"
        },
        "source_work_id": {
          "$ref": "#/$defs/workId"
        },
        "retry_index": {
          "type": "integer",
          "minimum": 1
        },
        "trigger_trial_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "description": "Sorted in UTF-8 byte order.",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000\\r\\n]+$"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "source_work_id",
        "rerun_id",
        "assessment_id"
      ],
      "properties": {
        "schema_version": {
          "const": "2"
        },
        "kind": {
          "const": "verifier-only"
        },
        "source_work_id": {
          "$ref": "#/$defs/workId"
        },
        "rerun_id": {
          "type": "string",
          "pattern": "^rerun_[a-f0-9]{32}$"
        },
        "assessment_id": {
          "type": "string",
          "pattern": "^assessment_[a-f0-9]{32}$"
        }
      }
    }
  ],
  "$defs": {
    "workId": {
      "type": "string",
      "pattern": "^work_[a-f0-9]{32}$"
    }
  }
}
