{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/eval-result.schema.json",
  "title": "Hitch eval result",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "eval_id", "status", "exit_code", "started_at", "completed_at"],
  "properties": {
    "schema_version": { "const": "1" },
    "eval_id": { "type": "string", "pattern": "^eval_[a-f0-9]{32}$" },
    "status": { "enum": ["succeeded", "failed", "cancelled"] },
    "exit_code": { "type": "integer", "minimum": 0 },
    "backend": {
      "type": "object",
      "required": ["name", "executable", "identity", "config_path", "process_exit_code"],
      "properties": {
        "name": { "const": "harbor" },
        "executable": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "identity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "config_path": { "type": "string", "minLength": 1 },
        "result_path": { "type": ["string", "null"] },
        "process_exit_code": { "type": ["integer", "null"] }
      },
      "additionalProperties": true
    },
    "summary": { "type": ["object", "null"] },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  }
}
