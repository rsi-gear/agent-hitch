{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hitch.local/schemas/eval-result.schema.json",
  "title": "Hitch eval result",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "eval_id", "benchmark_id", "benchmark_revision", "status", "exit_code", "trials", "started_at", "completed_at"],
  "properties": {
    "schema_version": { "const": "1" },
    "eval_id": { "type": "string", "pattern": "^eval_[a-f0-9]{32}$" },
    "status": { "enum": ["succeeded", "failed", "cancelled"] },
    "exit_code": { "type": "integer", "minimum": 0 },
    "backend": {
      "type": "object",
      "required": ["name", "executable", "identity", "config_path", "process_exit_code"],
      "properties": {
        "name": { "const": "harbor" },
        "executable": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "identity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "config_path": { "type": "string", "minLength": 1 },
        "result_path": { "type": ["string", "null"] },
        "process_exit_code": { "type": ["integer", "null"] }
      },
      "additionalProperties": true
    },
    "summary": { "type": ["object", "null"] },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "benchmark_revision": { "type": "string", "minLength": 1 },
    "prepared_artifact": {
      "type": "object",
      "required": ["artifact_id", "artifact_integrity", "entrypoint_integrity", "harness_id", "revision_identity", "platform", "source_type"],
      "properties": {
        "artifact_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "artifact_integrity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "entrypoint_integrity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "harness_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "revision_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "platform": { "type": "string", "pattern": "^(?:linux|darwin|win32)-[a-z0-9_]+$" },
        "source_type": { "enum": ["npm", "git"] }
      },
      "additionalProperties": false
    },
    "trials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trial_id", "run_id", "task_id", "attempt", "observation_status"],
        "properties": {
          "trial_id": { "type": "string", "minLength": 1 },
          "run_id": { "type": "string", "pattern": "^run_[a-f0-9]{32}$" },
          "task_id": { "type": "string", "minLength": 1 },
          "attempt": { "type": "integer", "minimum": 1 },
          "observation_status": { "enum": ["valid", "invalid"] },
          "reward": { "type": "number" },
          "verifier_result_ref": { "type": "string", "minLength": 1 },
          "invalid_reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "local_source_transport": {
      "type": "object",
      "required": ["kind", "resolution_identity", "commit", "tree", "payload_sha256", "payload_bytes"],
      "properties": {
        "kind": { "const": "local-git-commit" },
        "resolution_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "tree": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "payload_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "payload_bytes": { "type": "integer", "minimum": 0 },
        "object_count": { "type": "integer", "minimum": 0 },
        "file_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  }
}
